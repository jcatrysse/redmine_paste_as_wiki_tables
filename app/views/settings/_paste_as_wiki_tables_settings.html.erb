<p>
  <%= label_tag 'enable_table_paste', t('labels.enable_table_paste') %>
  <%= hidden_field_tag 'settings[enable_table_paste]', 0, id: nil %>
  <%= check_box_tag 'settings[enable_table_paste]', 1,
                    %w[1 true].include?(@settings['enable_table_paste'].to_s) %>
  <br>
  <small><%= t('descriptions.enable_table_paste') %></small>
</p>
