<% paste_settings = Setting.plugin_redmine_paste_as_wiki_tables || {} %>
<%# Defaults are booleans, saved values are '1' or '0' %>
<% paste_enabled = lambda { |key| %w[1 true].include?(paste_settings[key].to_s) } %>
<script type="text/javascript">
    $(function() {
        const enableTablePaste = <%= paste_enabled.call('enable_table_paste').to_json %>;
        const enableImagePaste = <%= paste_enabled.call('enable_image_paste').to_json %>;
        const enableAutoSubmit = <%= paste_enabled.call('enable_auto_submit').to_json %>;
        const textFormatting = <%= raw json_escape(Setting.text_formatting.to_s.to_json) %>;
        const messageSaveIssue = <%= raw json_escape(t('messages.save_issue').to_json) %>;
        const messageSaveNotesFirst = <%= raw json_escape(t('messages.save_notes_first').to_json) %>;

        function insert(textarea, text) {
            const field = $(textarea).focus().get(0);
            // setRangeText replaces the selection and keeps the text after it
            field.setRangeText(text, field.selectionStart, field.selectionEnd, 'end');
            field.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function isTable(text) {
            const lines = $.trim(text).split(/\r?\n/);
            if (lines.length < 2) {
                return false;
            }

            const cellCount = lines[0].split('\t').length;
            return cellCount > 1 && lines.every(line => line.split('\t').length === cellCount);
        }

        function toTable(text) {
            const lines = $.trim(text).split(/\r?\n/);

            if (lines.length === 0) {
                return text;
            }

            const cells = line => line.split('\t');
            const firstLineCells = cells(lines[0]);

            if (textFormatting === "markdown" || textFormatting === "common_mark") {
                const escape = cell => cell.replace(/\|/g, '\\|');
                const row = line => "| " + cells(line).map(escape).join(" | ") + " |\n";
                const header = row(lines[0]);
                const separator = "|" + new Array(firstLineCells.length).fill("---").join("|") + "|\n";
                const rows = lines.slice(1).map(row).join('');
                return header + separator + rows;
            } else if (textFormatting === "textile") {
                const escape = cell => cell.replace(/\|/g, '&#124;');
                const header = "| " + firstLineCells.map(cell => "_." + escape(cell)).join(" | ") + " |\n";
                const rows = lines.slice(1).map(line => "| " + cells(line).map(escape).join(" | ") + " |\n").join('');
                return header + rows;
            } else {
                return text;
            }
        }

        function handleTextPaste(e, clipboardData) {
            const text = clipboardData.getData('text');
            const $this = $(e.target);

            if (isTable(text)) {
                insert($this, toTable(text));
                e.preventDefault(); // To stop the default paste action.
                return true;
            }
            return false;
        }

        function handleImagePaste(e, clipboardData) {
            if (!(window.File && window.FileList && window.ProgressEvent && window.FormData)) {
                return;
            }

            const $this = $(e.target);

            if ($this.is('textarea[id^="journal_"]')) {
                const items = clipboardData.items;
                let file_upload = false;

                $.event.addProp('dataTransfer');

                for (let i = 0; i < items.length; i++) {
                    if (items[i].type.indexOf("image") !== -1) {
                        file_upload = uploadImage(e, items[i]) || file_upload;
                    }
                }

                if (file_upload) {
                    handleFormSubmission($this);
                    startTokenObservation($this);
                }
            }
        }

        function uploadImage(e, item) {
            const blob = item.getAsFile();
            const date = new Date();
            const filename = constructFilename(date, blob);
            const file = new Blob([blob], { type: blob.type });
            file.name = filename;

            const inputEl = $('input:file.filedrop').first();
            handleFileDropEvent.target = e.target;
            addFile(inputEl, file, true);

            return true;
        }

        function constructFilename(date, blob) {
            return 'clipboard-'
              + date.getFullYear()
              + ('0' + (date.getMonth() + 1)).slice(-2)
              + ('0' + date.getDate()).slice(-2)
              + ('0' + date.getHours()).slice(-2)
              + ('0' + date.getMinutes()).slice(-2)
              + '-' + randomKey(5).toLocaleLowerCase()
              + '.' + blob.name.split('.').pop();
        }

        function handleFormSubmission($this) {
            const $notesForm = $this.closest('form');
            const $mainForm = $(document.getElementById('issue-form'));
            $('#update').show();

            setupFormSubmitHandlers($notesForm, $mainForm);
        }

        function handlePreview($this) {
            const $notesForm = $this.closest('form');
            const $mainForm = $(document.getElementById('issue-form'));

            if ($notesForm.find('.attachments_fields').length === 0) {
                $notesForm.append($('<div class="attachments_fields"></div>'));
            }

            $notesForm.find('.attachments_fields input').remove();

            $mainForm.find('.attachments_fields input').each(function() {
                const $input = $(this);
                $notesForm.find('.attachments_fields').append($('<input>', {
                    type: 'hidden',
                    name: $input.attr('name'),
                    value: $input.val()
                }));
            });
        }

        function startTokenObservation($this) {
            const $mainForm = $(document.getElementById('issue-form'));
            const $lastToken = $mainForm.find('.attachments_fields input.token').last();
            const config = { attributes: true, attributeFilter: ['value'], childList: false, subtree: true };

            const observer = new MutationObserver(mutations => {
                if ($lastToken.val() !== "") {
                    handlePreview($this);
                    observer.disconnect();
                }
            });

            if ($lastToken.length) {
                observer.observe($lastToken[0], config);
            }
        }

        function setupFormSubmitHandlers($notesForm, $mainForm) {
            $notesForm.off('submit').on('submit', function () {
                if (enableAutoSubmit) {
                    $notesForm.remove();
                    submitForm($mainForm);
                } else {
                    alert(messageSaveIssue);
                }
            });

            $mainForm.off('submit').on('submit', function(e) {
                if ($('#' + $notesForm.attr('id')).length > 0) {
                    if (!confirm(messageSaveNotesFirst)) {
                        return false;
                    } else {
                        submitForm($mainForm);
                    }
                } else {
                    submitForm($mainForm);
                }
            });
        }

        function submitForm(form) {
            form.off('submit');
            form.trigger("submit");
        }

        $(document).on('paste', '.wiki-edit', function (e) {
            if (e.isDefaultPrevented()) { return; } // already handled, e.g. by Redmine's own table paste
            const clipboardData = e.clipboardData || e.originalEvent.clipboardData;
            if (!clipboardData) { return; }

            if (enableTablePaste && clipboardData.types.some(t => /^text\/plain$/.test(t)) &&
                handleTextPaste(e, clipboardData)) {
                return;
            }
            if (enableImagePaste) {
                handleImagePaste(e, clipboardData);
            }
        });
    });
</script>
